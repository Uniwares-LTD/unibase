# Local defaults. Copy to .env.local to customize.
APP_NAME=Base
APP_STYLE=classic
APP_ENV=local
APP_ORIGIN=http://localhost:3000

# APP_STYLE: classic | glass | soft-blue. Browser/account choices can override this default.
# APP_NAME, APP_STYLE and Firebase browser identifiers are explicitly allowlisted.
# APP_ENV: local | staging | production. Non-local environments require an
# explicit HTTPS APP_ORIGIN with no credentials, path, query, or fragment.
# Never prefix server credentials with NEXT_PUBLIC_.

# Local development uses a demo project and isolated local MongoDB.
AUTH_MODE=emulator
FIREBASE_PROJECT_ID=demo-unitale
FIREBASE_API_KEY=demo-api-key
FIREBASE_APP_ID=demo-app-id
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=unitale_local

# For staging/production: AUTH_MODE=firebase, real Firebase public identifiers,
# HTTPS APP_ORIGIN, and a scoped Atlas connection/database. Remove
# FIREBASE_AUTH_EMULATOR_HOST entirely. Firebase Admin uses Application Default
# Credentials, e.g. GOOGLE_APPLICATION_CREDENTIALS=/secure/service-account.json.
# Store the credential file outside this repository. Do not commit real values.

# Android build identity. Required by npm run android:generate; no hardcoded defaults.
# Set the production hostname only (no scheme/path) and reverse-domain package ID.
ANDROID_HOST=
ANDROID_PACKAGE_NAME=
# Optional until signing is configured. Use the PLAY APP-SIGNING SHA-256
# certificate, not just the upload certificate: 32 colon-separated hex bytes.
# Comma-separate multiple certificates for rotation. Empty disables association.
ANDROID_SHA256_FINGERPRINTS=

# Credits: local emulator mode defaults to clearly labelled fixture simulation.
# Outside local emulator mode payments default to disabled. No real money is
# charged by simulation; it is rejected in staging/production.
# PAYMENTS_MODE=disabled
# CREDIT_PACKS_JSON=[{"id":"pack-100","label":"100 credits","credits":100}]
# Stripe is opt-in. Supply your own one-time Price ID, positive minor-unit amount
# and lowercase ISO currency per pack. The server verifies them against Stripe.
# PAYMENTS_MODE=stripe
# CREDIT_PACKS_JSON=[{"id":"your-pack","label":"Your pack","credits":100,"stripePriceId":"price_YOURID","amountMinor":500,"currency":"usd"}]
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Refunds/disputes are initiated in Stripe's console, never by public grant APIs.

# Optional AI execution. Disabled is the default; fake makes no provider calls.
DIFY_MODE=disabled
# Optional MCP tools for trusted server clients. Independent of Dify mode.
MCP_ENABLED=false
# Generate each token with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# MCP_CLIENTS_JSON=[{"id":"dify","tokenEnv":"MCP_TOKEN_DIFY","permissions":["server:read","reference:read","demo:read"]}]
# MCP_TOKEN_DIFY=
# Additional exact public hosts for a tunnel; no scheme, path or wildcard.
# MCP_ALLOWED_HOSTS_JSON=["your-tunnel.example.com"]
# In local testing use DIFY_MODE=fake and run npm run worker:ai separately.
# Self-hosted Dify 1.17.1. App execution keys and admin key stay server-only.
# DIFY_BASE_URL=https://dify.example.com/v1
# Optional seed registrations. Missing keys leave registrations unavailable.
# DIFY_ORCHESTRATORS_JSON=[{"id":"main","name":"Main orchestrator","description":"","order":0,"enabled":false,"keyEnv":"DIFY_KEY_MAIN","workflowId":"PUBLISHED-WORKFLOW-UUID","inputs":[{"name":"prompt","label":"Request","kind":"paragraph","required":true,"options":[]}],"pricing":null,"recovery":null}]
# DIFY_KEY_MAIN=app-PRIVATE-KEY
# Console connection for discovery/registration; enable admin API key support in Dify.
# Register reads drafts/tool metadata, publishes when changed, and may create an app key.
# DIFY_CONSOLE_URL=https://dify.example.com/console/api
# DIFY_MANAGEMENT_KEY=PRIVATE-ADMIN-KEY
# DIFY_WORKSPACE_ID=WORKSPACE-UUID
# Create also requires app import/site-setting permissions and a connected
# Unibase MCP provider with get_reference_document_v1. New public Web Apps are disabled.
# Automatic registration reuses an existing app API key or creates one, then
# encrypts it in MongoDB. Web and AI workers must share the encryption secret.
# Optional stable 32-byte secret (64 hex characters). Without it, encryption
# derives from DIFY_MANAGEMENT_KEY; rotating that key requires reconnecting apps.
# DIFY_CREDENTIAL_ENCRYPTION_KEY=

# Private Run assets. MongoDB is the default and needs no extra credentials.
# Images: up to 8 MiB in MongoDB, 20 MiB in S3; both cap decoding at 16M pixels.
ASSET_STORE=mongo
# Optional S3-compatible private bucket. Use a scoped credential for this prefix.
# ASSET_STORE=s3
# ASSET_S3_ENDPOINT=https://your-s3-endpoint.example
# ASSET_S3_REGION=your-region
# ASSET_S3_BUCKET=your-private-bucket
# ASSET_S3_PREFIX=run-assets
# ASSET_S3_ACCESS_KEY_ID=
# ASSET_S3_SECRET_ACCESS_KEY=
# ASSET_S3_FORCE_PATH_STYLE=true

# Local defaults. Copy to .env.local to customize.
APP_NAME=Unitale
APP_STYLE=classic
APP_ENV=local
APP_ORIGIN=http://localhost:3000

# APP_STYLE: classic | glass | soft-blue. Browser/account choices can override this default.
# APP_NAME, APP_STYLE and Firebase browser identifiers are explicitly allowlisted.
# APP_ENV: local | staging | production. Non-local environments require an
# explicit HTTPS APP_ORIGIN with no credentials, path, query, or fragment.
# Never prefix server credentials with NEXT_PUBLIC_.

# Local development uses a demo project and isolated local MongoDB.
AUTH_MODE=emulator
FIREBASE_PROJECT_ID=demo-unitale
FIREBASE_API_KEY=demo-api-key
FIREBASE_APP_ID=demo-app-id
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=unitale_local

# For staging/production: AUTH_MODE=firebase, real Firebase public identifiers,
# HTTPS APP_ORIGIN, and a scoped Atlas connection/database. Remove
# FIREBASE_AUTH_EMULATOR_HOST entirely. Firebase Admin uses Application Default
# Credentials, e.g. GOOGLE_APPLICATION_CREDENTIALS=/secure/service-account.json.
# Store the credential file outside this repository. Do not commit real values.

# Android build identity. Required by npm run android:generate; no hardcoded defaults.
# Set the production hostname only (no scheme/path) and reverse-domain package ID.
ANDROID_HOST=
ANDROID_PACKAGE_NAME=
# Optional until signing is configured. Use the PLAY APP-SIGNING SHA-256
# certificate, not just the upload certificate: 32 colon-separated hex bytes.
# Comma-separate multiple certificates for rotation. Empty disables association.
ANDROID_SHA256_FINGERPRINTS=

# Credits: local emulator mode defaults to clearly labelled fixture simulation.
# Outside local emulator mode payments default to disabled. No real money is
# charged by simulation; it is rejected in staging/production.
# PAYMENTS_MODE=disabled
# CREDIT_PACKS_JSON=[{"id":"pack-100","label":"100 credits","credits":100}]
# Stripe is opt-in. Supply your own one-time Price ID, positive minor-unit amount
# and lowercase ISO currency per pack. The server verifies them against Stripe.
# PAYMENTS_MODE=stripe
# CREDIT_PACKS_JSON=[{"id":"your-pack","label":"Your pack","credits":100,"stripePriceId":"price_YOURID","amountMinor":500,"currency":"usd"}]
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Refunds/disputes are initiated in Stripe's console, never by public grant APIs.

# Optional AI execution. Disabled is the default; fake makes no provider calls.
DIFY_MODE=disabled
# In local testing use DIFY_MODE=fake and run npm run worker:ai separately.
# Live bindings stay server-side. Use the complete API base URL ending in /v1.
# DIFY_BASE_URL=https://your-dify-host.example/v1
# DIFY_BINDINGS_JSON=[{"name":"assistant-text","revision":"1","kind":"workflow","apiKeyEnv":"DIFY_KEY_ASSISTANT_TEXT","workflowId":"YOUR-PUBLISHED-WORKFLOW-UUID"}]
# DIFY_KEY_ASSISTANT_TEXT=
# assistant-text expects a prompt input and a text output. Its default is 1
# application credit (overridable by AI_PRICING_JSON); provider-reported monetary costs are collected separately.

# Optional per-capability credit pricing. Empty retains fixed registry prices.
# Decimal rates must be JSON strings. See docs/ai-testing.md for all modes.
# Example (synthetic rates): {"assistant-text":{"mode":"tokens","maxCredits":10,"rate":{"basis":"total","creditsPerMillion":"1000"}}}
AI_PRICING_JSON=

          "enabled": false
        },
        "speech_to_text": {
          "enabled": false
        },
        "text_to_speech": {
          "enabled": false
        }
      },
      "graph": {
        "nodes": [
          {
            "id": "start",
            "type": "custom",
            "data": {
              "type": "start",
              "title": "Start",
              "variables": [],
              "desc": "",
              "selected": false

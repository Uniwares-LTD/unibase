{
  "id": "quote-approval",
  "title": "Quote approval",
  "description": "Calculate a demo quote and test human approval or rejection. No purchase is made.",
  "requiredTools": ["calculate_demo_quote_v1"],
  "dsl": {
    "version": "0.6.0",
    "kind": "app",
    "dependencies": [],
    "app": {
      "name": "Unibase quote approval",

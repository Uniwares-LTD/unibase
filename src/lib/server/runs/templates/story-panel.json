                  "variable": "story",
                  "value_selector": ["revised_story", "text"]
                },
                {
                  "variable": "character",
                  "value_selector": ["character", "text"]
                },
                {
                  "variable": "reference",
                  "value_selector": ["read", "json"]
                }

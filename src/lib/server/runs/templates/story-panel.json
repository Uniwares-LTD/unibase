              "code": "def main(story: str, character: str, reference: list) -> dict:\n    if not story.strip() or len(story) > 1200 or not character.strip() or len(character) > 900: raise ValueError('Content exceeds review bounds')\n    artifact = next(x for x in reference if isinstance(x, dict) and 'artifactId' in x)\n    revision = artifact['revision']\n    if not isinstance(revision, int) or isinstance(revision, bool) or revision < 0: raise ValueError('Invalid artifact revision')\n    return {'text':'Story\\n'+story+'\\n\\nCharacter\\n'+character, 'revision':revision, 'prompt':'Create one polished, colorful comic panel for readers aged 8–13. Illustrate the key scene in the story using exactly the approved character description. No captions, speech bubbles, text, or watermarks.\\nStory: '+story+'\\nCharacter: '+character}\n",

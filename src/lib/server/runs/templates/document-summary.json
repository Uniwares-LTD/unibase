              "x": 330,
              "y": 100
            },
            "sourcePosition": "right",
            "targetPosition": "left",
            "width": 244,
            "height": 100
          },
          {
            "id": "decision",
            "type": "custom",
            "data": {
              "type": "human-input",
              "title": "Choose a summary",
              "form_content": "```unibase-ui\n{\"version\":1,\"cards\":[{\"id\":\"direction\",\"content\":{\"type\":\"question\",\"version\":1,\"data\":{\"kind\":\"single\",\"title\":\"Choose a summary\",\"explanation\":\"The demo document was fetched through MCP. Choose how to present it.\",\"options\":[{\"id\":\"brief\",\"label\":\"Brief\"},{\"id\":\"detailed\",\"label\":\"Detailed\"}]}}}]}\n```\n{{#$output.response#}}",
              "inputs": [
                {
                  "type": "paragraph",
                  "output_variable_name": "response",
                  "default": {
                    "type": "constant",
                    "selector": [],
                    "value": ""
                  }

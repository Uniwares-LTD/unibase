                {
                  "id": "continue",
                  "title": "Continue",
                  "button_style": "primary"
                }
              ],
              "delivery_methods": [
                {
                  "id": "00000000-0000-4000-8000-000000000010",
                  "type": "webapp",
                  "enabled": true,
                  "config": {}
                }

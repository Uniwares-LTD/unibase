            "type": "custom",
            "data": {
              "type": "end",
              "title": "Result",
              "outputs": [
                {
                  "variable": "text",
                  "value_selector": ["compose", "text"]
                }
              ],
              "desc": "",
              "selected": false
            },
            "position": {
              "x": 1230,
              "y": 100
            },
            "sourcePosition": "right",
            "targetPosition": "left",
            "width": 244,
            "height": 100
          }
        ],
        "edges": [
          {

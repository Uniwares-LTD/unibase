{
  "id": "persona-responder",
  "title": "Persona responder",
  "description": "Simple persona LLM: any question shape to a raw answer. Configure its model in Dify.",
  "requiredTools": [],
  "dsl": {
    "version": "0.6.0",
    "kind": "app",
    "dependencies": [],
    "app": {
      "name": "Unibase persona responder",
      "description": "Simple persona LLM: any question shape to a raw answer. Configure its model in Dify.",
      "mode": "workflow",
      "icon_type": "emoji",
      "icon": "🧪",
      "icon_background": "#FFEAD5",
      "use_icon_as_answer_icon": false
    },
    "workflow": {
      "conversation_variables": [],
      "environment_variables": [],
      "features": {
        "file_upload": {
          "enabled": false
        },
        "opening_statement": "",
        "suggested_questions": [],
        "suggested_questions_after_answer": {
          "enabled": false
        },
        "speech_to_text": {
          "enabled": false
        },
        "text_to_speech": {
          "enabled": false
        }
      },
      "graph": {
        "nodes": [
          {
            "id": "start",
            "type": "custom",
            "data": {
              "desc": "",
              "selected": false,
              "type": "start",
              "title": "Start",
              "variables": [
                {
                  "variable": "persona",
                  "label": "Persona",
                  "type": "paragraph",
                  "required": true,
                  "max_length": 4000
                },
                {
                  "variable": "question",
                  "label": "Question",
                  "type": "paragraph",
                  "required": true,
                  "max_length": 4000
                },
                {
                  "variable": "context",
                  "label": "Context",
                  "type": "paragraph",
                  "required": true,
                  "max_length": 4000
                }
              ]
            },
            "position": {
              "x": 30,
              "y": 100
            },
            "sourcePosition": "right",
            "targetPosition": "left",
            "width": 244,
            "height": 100
          },
          {
            "id": "answer",
            "type": "custom",
            "data": {
              "desc": "",
              "selected": false,
              "type": "llm",
              "title": "Answer as persona",
              "model": {
                "provider": "langgenius/openai/openai",
                "name": "gpt-4.1-mini",
                "mode": "chat",
                "completion_params": {
                  "temperature": 0.3,
                  "max_tokens": 2000
                }
              },
              "prompt_template": [
                {
                  "role": "system",
                  "text": "Answer the question as the supplied persona, using context. Accept any question shape and use its requested answer format and JSON value types. For an interactive Unibase form, return only {\"action\":\"offered action ID\",\"answers\":{\"card or field ID\":value}} with native values, not a JSON-encoded answers string. Form answers are objects keyed by field IDs; summary/issue acknowledgements are null. Do not invent file uploads or claim human approval."
                },
                {
                  "role": "user",
                  "text": "Persona: {{#start.persona#}}\nQuestion: {{#start.question#}}\nContext: {{#start.context#}}"
                }
              ],
              "context": {
                "enabled": false,
                "variable_selector": []
              },
              "vision": {
                "enabled": false
              },
              "structured_output_enabled": false
            },
            "position": {
              "x": 330,
              "y": 100
            },
            "sourcePosition": "right",
            "targetPosition": "left",
            "width": 244,
            "height": 100
          },
          {
            "id": "end",
            "type": "custom",
            "data": {
              "desc": "",
              "selected": false,
              "type": "end",
              "title": "Answer",
              "outputs": [
                {
                  "variable": "answer",
                  "value_selector": ["answer", "text"]
                }
              ]
            },
            "position": {
              "x": 630,
              "y": 100
            },
            "sourcePosition": "right",
            "targetPosition": "left",
            "width": 244,
            "height": 100
          }
        ],
        "edges": [
          {
            "id": "start-answer",
            "source": "start",
            "target": "answer",
            "sourceHandle": "source",
            "targetHandle": "target",
            "type": "custom",
            "data": {
              "sourceType": "start",
              "targetType": "llm",
              "isInIteration": false,
              "isInLoop": false
            }
          },
          {
            "id": "answer-end",
            "source": "answer",
            "target": "end",
            "sourceHandle": "source",
            "targetHandle": "target",
            "type": "custom",
            "data": {
              "sourceType": "llm",
              "targetType": "end",
              "isInIteration": false,
              "isInLoop": false
            }
          }
        ]
      }
    }
  }
}

diff --git a/scripts/shared-app-routes.py b/scripts/shared-app-routes.py
new file mode 100644
--- /dev/null
+++ b/scripts/shared-app-routes.py
@@ -0,0 +1,68 @@
+"""Validate the owner's registry. Requests can select registered apps, not URLs."""
+import argparse
+import json
+import re
+import sys
+from pathlib import Path
+
+
+def validate(registry, config):
+    if registry.get("version") != 1 or registry.get("ownerRepository") != config["repository"]:
+        raise ValueError("Shared registry owner mismatch")
+    enabled = [entry for entry in registry.get("applications", []) if entry.get("enabled") is True]
+    if enabled:
+        if registry.get("cloudflareAccountId") != config["cloudflare_account_id"] or registry.get("cloudflareZoneId") != config["cloudflare_zone_id"]:
+            raise ValueError("Shared registry Cloudflare identities mismatch")
+        from uuid import UUID
+        if str(UUID(registry.get("tunnelId") or "")) != registry["tunnelId"]:
+            raise ValueError("Invalid existing tunnel identity")
+    hosts = {config["deploy_hostname"], config["dify_hostname"], *[value["APP_HOSTNAME"] for value in config["environments"].values()]}
+    ports = {22, 3100, 3200, 3300}
+    identities, results = set(), {}
+    for entry in registry.get("applications", []):
+        if type(entry.get("enabled")) is not bool:
+            raise ValueError("Registry entry needs an explicit enabled flag")
+        if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", entry.get("repository", "")) or not re.fullmatch(r"[a-z][a-z0-9-]{2,39}", entry.get("slug", "")) or entry.get("environment") not in ("staging", "production"):
+            raise ValueError("Invalid registered application identity")
+        identity = (entry["repository"].lower(), entry["slug"], entry["environment"])
+        if identity in identities:
+            raise ValueError("Duplicate registered application")
+        identities.add(identity)
+        if not entry["enabled"]:
+            continue
+        host, port = entry.get("hostname"), entry.get("port")
+        if not isinstance(host, str) or not re.fullmatch(r"[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+", host):
+            raise ValueError("Invalid registered hostname")
+        if type(port) is not int or not 1024 <= port <= 65535 or port in ports or host in hosts:
+            raise ValueError("Registered route conflicts with an allocated hostname/port")
+        key = entry["slug"] + "-" + entry["environment"]
+        if key in results:
+            raise ValueError("Registered application namespace collision")
+        hosts.add(host)
+        ports.add(port)
+        results[key] = {"hostname": host, "port": port}
+    return results
+
+
+if __name__ == "__main__":
+    try:
+        parser = argparse.ArgumentParser()
+        parser.add_argument("--registry", type=Path, required=True)
+        parser.add_argument("--config", type=Path, required=True)
+        parser.add_argument("--export", action="store_true")
+        parser.add_argument("--repository")
+        parser.add_argument("--slug")
+        parser.add_argument("--environment", choices=["staging", "production"])
+        args = parser.parse_args()
+        registry = json.loads(args.registry.read_text())
+        routes = validate(registry, json.loads(args.config.read_text()))
+        if not args.export:
+            selected = [entry for entry in registry["applications"] if entry["repository"] == args.repository and entry["slug"] == args.slug and entry["environment"] == args.environment and entry["enabled"]]
+            if len(selected) != 1:
+                raise ValueError("Requested app is not uniquely enabled in the owner's registry")
+            print("verified: registered shared application route")
+        else:
+            print(json.dumps(routes, separators=(",", ":")))
+    except Exception as error:
+        print(str(error) if isinstance(error, ValueError) else "Invalid shared route registry", file=sys.stderr)
+        sys.exit(1)
diff --git a/tests/shared_routes_test.py b/tests/shared_routes_test.py
new file mode 100644
--- /dev/null
+++ b/tests/shared_routes_test.py
@@ -0,0 +1,52 @@
+import copy
+import importlib.util
+import unittest
+from pathlib import Path
+
+spec = importlib.util.spec_from_file_location("shared_routes", Path(__file__).resolve().parents[1] / "scripts/shared-app-routes.py")
+module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(module)
+
+
+class SharedRouteTests(unittest.TestCase):
+    def setUp(self):
+        self.config = {"repository": "fixture/owner", "cloudflare_account_id": "fixture-account", "cloudflare_zone_id": "fixture-zone",
+                       "deploy_hostname": "ssh.example.test", "dify_hostname": "dify.example.test", "environments": {
+                           "staging": {"APP_HOSTNAME": "booklet-staging.example.test"}, "prod": {"APP_HOSTNAME": "booklet.example.test"}}}
+        self.registry = {"version": 1, "ownerRepository": "fixture/owner", "cloudflareAccountId": "fixture-account",
+                         "cloudflareZoneId": "fixture-zone", "tunnelId": "11111111-1111-4111-8111-111111111111", "applications": [
+                             {"repository": "fixture/app", "slug": "unibase", "environment": "staging", "hostname": "unibase-staging.example.test", "port": 35101, "enabled": True},
+                             {"repository": "fixture/app", "slug": "unibase", "environment": "production", "hostname": "unibase.example.test", "port": 35102, "enabled": True}]}
+
+    def test_routes_have_stable_namespace_keys(self):
+        first = module.validate(self.registry, self.config)
+        self.assertEqual(first, module.validate(copy.deepcopy(self.registry), self.config))
+        self.assertEqual(set(first), {"unibase-staging", "unibase-production"})
+
+    def test_host_and_port_collisions_are_rejected(self):
+        for change in ({"port": 35101}, {"hostname": "unibase-staging.example.test"}, {"port": 3100},
+                       {"port": 3200}, {"port": 3300}, {"hostname": "ssh.example.test"}, {"hostname": "dify.example.test"}):
+            registry = copy.deepcopy(self.registry)
+            registry["applications"][1].update(change)
+            with self.assertRaises(ValueError):
+                module.validate(registry, self.config)
+
+    def test_duplicate_identity_and_namespace_are_rejected(self):
+        for repository in ("fixture/app", "another/app"):
+            registry = copy.deepcopy(self.registry)
+            item = copy.deepcopy(registry["applications"][0])
+            item.update(repository=repository, hostname="other.example.test", port=35103)
+            registry["applications"].append(item)
+            with self.assertRaises(ValueError):
+                module.validate(registry, self.config)
+
+    def test_disabled_placeholders_publish_nothing(self):
+        for item in self.registry["applications"]:
+            item.update(enabled=False, hostname=None)
+        self.registry.update(tunnelId=None, cloudflareAccountId=None, cloudflareZoneId=None)
+        self.assertEqual(module.validate(self.registry, self.config), {})

new file mode 100644
--- /dev/null
+++ b/.github/workflows/shared-app-routes.yml
@@ -0,0 +1,57 @@
+name: Shared application routes
+run-name: Shared routes ${{ inputs.repository }} ${{ inputs.request_id }}
+on:
+  workflow_dispatch:
+    inputs:
+      repository:
+        type: string
+        required: true
+      slug:
+        type: string
+        required: true
+      environment:
+        type: choice
+        options: [staging, production]
+        required: true
+      request_id:
+        type: string
+        required: true
+      apply:
+        type: boolean
+        default: false
+permissions:
+  contents: read
+jobs:
+  validate:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
+      - name: Validate owner branch and registered caller
+        env:
+          CALLER_REPOSITORY: ${{ inputs.repository }}
+          CALLER_SLUG: ${{ inputs.slug }}
+          TARGET: ${{ inputs.environment }}
+        run: |
+          test "$GITHUB_REF" = refs/heads/master
+          python3 scripts/shared-app-routes.py --registry infra/config/shared-app-routes.json --config infra/config/vps.json --repository "$CALLER_REPOSITORY" --slug "$CALLER_SLUG" --environment "$TARGET"
+      - name: Summarize registry check
+        if: always()
+        env:
+          OUTCOME: ${{ job.status }}
+          TARGET: ${{ inputs.environment }}
+          REQUEST_ID: ${{ inputs.request_id }}
+        run: |
+          python3 - <<'PY'
+          import os
+          import re
+          request = os.environ['REQUEST_ID']
+          if not re.fullmatch(r'[a-f0-9-]{36}', request): request = 'invalid'
+          with open(os.environ['GITHUB_STEP_SUMMARY'], 'a') as file:
+              file.write('Shared route registry: outcome=' + os.environ['OUTCOME'] + ' environment=' + os.environ['TARGET'] + ' request=' + request + '\n')
+          PY
+  reconcile:
+    needs: validate
+    uses: ./.github/workflows/infrastructure.yml
+    with:
+      apply: ${{ inputs.apply }}
+    secrets: inherit
diff --git a/docs/architecture.md b/docs/architecture.md
--- a/docs/architecture.md
+++ b/docs/architecture.md
@@ -783,3 +783,23 @@
 ### Consolidated VPS deployment boundary
 
 VPS deployment is owned by `scripts/deploy/vps-deployment.sh`. Setup discovers Cloudflare and host ownership and configures database-scoped Atlas users and the exact VPS allowlist. Finalize creates absent environment branches from the reviewed commit containing `infra/config/vps.json`. Terraform owns Cloudflare R2, Tunnel, DNS and cache/rate-limit resources. `_staging` and `_prod` are independent reviewed release lines and may diverge from `master`. GitHub Actions verify the current environment-branch commit, build public GHCR environment-tagged images, and deploy only their immutable digests through the restricted VPS command interface. Compose overlays hold non-secret configuration; root-only final overrides hold secrets, including staged rotation files. Preview is the default and mutations require `--apply`. TypeScript owns application initialization, readiness, drain, backup/restore, and staging-reset behavior.
+
+## Registered applications on the shared tunnel
+
+`infra/config/shared-app-routes.json` is the tracked registry for additional apps.
+The canonical infrastructure entrypoint validates it and supplies its enabled
+routes to Terraform on every plan/apply. Existing Booklet, SSH and Dify routes
+remain owned here. App repositories must not write the tunnel ingress list.
+
+Register the app repository, slug, environment, hostname and loopback port in a
+reviewed owner change. Fill the existing tunnel/account/zone identifiers and enable
+the entry only after allocation review. Disabled placeholders route nothing.
+`Shared application routes` accepts only an enabled registered app; it invokes the
+same serialized Infrastructure workflow and retains its plan/ownership safeguards.
+The workflow defaults to preview. Shared application DNS cannot be silently deleted.
+
+Follow-up: transfer shared tunnel ownership to a dedicated infrastructure owner,
+including Terraform state, route registry, SSH Access credentials, concurrency and
+preservation of every existing route. Transfer Dify Community ownership separately,
+including its pinned installation, private credentials, backups/state and service
+continuity. Neither ownership transfer nor Dify reinstallation is part of this change.
